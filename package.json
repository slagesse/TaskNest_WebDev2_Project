{
  "name": "our-angular-first",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "node server.js",
    "heroku-postbuild": "ng build && npx tsc -p backend/tsconfig.json",
    "dev": "ng serve",
    "backend": "nodemon --exec tsx backend/src/index.ts",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "server": "nodemon server.js",
    "test:backend": "vitest run --config backend/vitest.config.ts"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.6.2",
  "dependencies": {
    "@angular/cdk": "~21.2.0",
    "@angular/common": "^21.1.0",
    "@angular/compiler": "^21.1.0",
    "@angular/core": "^21.1.0",
    "@angular/forms": "^21.1.0",
    "@angular/material": "~21.2.0",
    "@angular/platform-browser": "^21.1.0",
    "@angular/router": "^21.1.0",
    "@apollo/server": "^5.5.1",
    "@as-integrations/express5": "^1.1.2",
    "body-parser": "^2.2.2",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "graphql": "^16.14.0",
    "mongodb": "^7.1.0",
    "mongoose": "^9.3.1",
    "multer": "^2.1.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@angular/build": "^21.1.4",
    "@angular/cli": "^21.1.4",
    "@angular/compiler-cli": "^21.1.0",
    "@angular/material": "^21.2.0",
    "@types/express": "^5.0.0",
    "@types/node": "^25.6.0",
    "@types/uuid": "^10.0.0",
    "jsdom": "^27.1.0",
    "nodemon": "^3.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
